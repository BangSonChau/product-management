mixin alert-success(time)
  - if (messages.success)
    .message.success
      div(
        class="alert alert-success alert-dismissible fade show",
        show-alert
        data-time=time
      ) #{messages.success} <span close-alert>x</span>

mixin alert-error(time)
  - if (messages.error)
    .message.error
      div(
        class="alert alert-danger alert-dismissible fade show",
        show-alert
        data-time=time
      ) #{messages.error} <span close-alert>x</span>

