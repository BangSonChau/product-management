extends  ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug

block main
  h1 Danh sách sản phẩm

  .card.mb-3
    .card-header Bộ lọc và Tìm kiếm
    .card-body
      .row
        .col-6
          +filter-status(filterStatus)
        .col-6
          +search(keyword)
  
  .card.mb-3
    .card-header Danh sách sản phẩm
    .card-body
      table.table.table-hover
        thead
          tr
            th STT
            th Hình ảnh
            th Tiêu đề
            th Giá
            th Trạng thái
            th Hành động
        tbody
          each item, index in products
            tr
              td #{index+1}
              td
                img.product-img(src=item.thumbnail alt="iPhone 9")
              td #{item.title}
              td #{item.price}$
              td
                if (item.status === "active")
                  button.badge.bg-success Hoạt động
                else
                  button.badge.bg-danger Dừng hoạt động
              td
                button.btn.btn-warning.btn-sm.me-1 Sửa
                button.btn.btn-danger.btn-sm Xóa

  +pagination(pagination)