extends  ../../layouts/default.pug

block main
  h1 Danh sách sản phẩm

  table.table.table-hover
    thead
      tr
        th STT
        th Hình ảnh
        th Tiêu đề
        th Giá
        th Trạng thái
        th Hành động
    tbody
      // Sản phẩm 1
      each item, index in products
        tr
          td #{index+1}
          td
            img.product-img(src=item.thumbnail alt="iPhone 9")
          td #{item.title}
          td #{item.price}$
          td
            if (item.status === "active")
              span.badge.bg-success Hoạt động
            else
              span.badge.bg-danger Dừng hoạt động
          td
            button.btn.btn-warning.btn-sm.me-1 Sửa
            button.btn.btn-danger.btn-sm Xóa
